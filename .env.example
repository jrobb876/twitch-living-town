# Safe starting point: simulations run without Twitch or Supabase credentials.
# Copy to ignored .env.local once. Never overwrite an existing configured file.
# Optional PUBLIC demo labels, embedded at build time; never put secrets here.
NEXT_PUBLIC_TOWN_NAME=Willowbrook
NEXT_PUBLIC_MAYOR_NAME=Mochi

# Server-only Twitch login: configure all four using YOUR application.
# Blank entries intentionally leave login unconfigured. No developer keys needed.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback
# Generate 32 random bytes as Base64 with the command in README.md.
# Placeholder: paste-your-generated-secret-here (do not use that literal value).
# Keep the real secret stable across durable-auth restarts; never share it.
SESSION_SECRET=

# Server-only genuine towns. Optional for demos, required for persistent features.
# Use your own project's HTTPS URL and new sb_secret_... API key.
# Not a publishable/anon key, legacy JWT service-role key or database password.
# Review/apply migrations 001–006 manually once in order; see supabase/README.md.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Set true ONLY for isolated local evaluation (never public hosting).
# Expanded OBS preview, Maplebrook and Dashboard Development Tools also require
# npm run dev, localhost/127.0.0.1 and PUBLIC_DEPLOYMENT=false.
# Maplebrook additionally needs genuine Twitch login, but no paid subscription/DB.
# Basic dev simulator/practice editor do not require this flag; production defaults
# hide them. Set demo/public flags BEFORE build and runtime; rebuild on changes.
TOWN_DEMO_MODE=false
PUBLIC_DEPLOYMENT=false

# Local default. Towns still persist with Supabase configured; login remains local.
# Public production: AUTH_STORAGE=supabase, PUBLIC_DEPLOYMENT=true,
# TOWN_DEMO_MODE=false, migration 006, stable SESSION_SECRET and registered HTTPS
# callback. Never share a production auth database with local/staging processes.
AUTH_STORAGE=memory

# Real integrations use My Town → Community → Connect My Twitch Community.
# Optional scopes: user:read:chat, channel:read:subscriptions,
# moderator:read:followers. No extra bot secrets or EventSub webhook are needed.
# Genuine house saves also need the streamer's valid subscriber authorization.
# Shell values (even empty ones) override .env.local. Restart Node after changes.
