# The local prototype runs without environment variables or credentials.
# Optional browser-visible names. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_TOWN_NAME=Willowbrook
NEXT_PUBLIC_MAYOR_NAME=Mochi
# Twitch, database and authentication configuration will be defined in a later phase.
# Set to true ONLY when building an explicitly authorized public/local demo.
# Production builds hide the simulator by default; this is evaluated at build time.
TOWN_DEMO_MODE=false
