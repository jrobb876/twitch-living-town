# The town/simulator run without credentials. Twitch login requires all four server variables below.
# Optional browser-visible names. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_TOWN_NAME=Willowbrook
NEXT_PUBLIC_MAYOR_NAME=Mochi
# Server-only Twitch application configuration (registered app: Living Town).
# Set real values only in the ignored .env.local; never use NEXT_PUBLIC_ for these.
TWITCH_CLIENT_ID=replace-with-your-twitch-client-id
TWITCH_CLIENT_SECRET=replace-with-your-twitch-client-secret
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback
# Generate a random 32-byte base64 secret using the command in README.md.
# This placeholder intentionally fails configuration validation.
SESSION_SECRET=replace-with-a-random-32-byte-base64-secret
# Real chat needs no extra variables or bot secrets. In the UI, explicitly authorize
# user:read:chat with Authorize Twitch Chat, then Connect Chat for your own channel.
# Run one long-lived Node process (npm run dev locally); no separate worker required.

# Set to true ONLY when building an explicitly authorized public/local demo.
# Production builds hide the simulator by default; this is evaluated at build time.
TOWN_DEMO_MODE=false
