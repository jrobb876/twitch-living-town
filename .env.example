# The town/simulator run without credentials. Twitch login requires all four server variables below.
# Optional browser-visible names. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_TOWN_NAME=Willowbrook
NEXT_PUBLIC_MAYOR_NAME=Mochi
# Server-only Twitch application configuration (registered app: Living Town).
# Set real values only in the ignored .env.local; never use NEXT_PUBLIC_ for these.
TWITCH_CLIENT_ID=replace-with-your-twitch-client-id
TWITCH_CLIENT_SECRET=replace-with-your-twitch-client-secret
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback
# Generate a random 32-byte base64 secret using the command in README.md.
# This placeholder intentionally fails configuration validation.
SESSION_SECRET=replace-with-a-random-32-byte-base64-secret
# Server-only persistent towns. Use a Supabase secret API key (sb_secret_...), not a
# publishable/anon key or the database password. Review/apply pending migrations
# in order through 006 for public deployment. Never rerun already-applied files.
# Never prefix these names with NEXT_PUBLIC_. Restart the server after configuration.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-supabase-secret-key
# Real chat needs no extra variables or bot secrets. In the UI, explicitly authorize
# user:read:chat with Authorize Twitch Chat, then Connect Chat for your own channel.
# Run one long-lived Node process (npm run dev locally); no separate worker required.
# Subscriber Housing uses the same configuration. Explicitly authorize
# channel:read:subscriptions for your own saved town, then Sync Subscribers and
# Connect subscription events. Existing chat scope is preserved. No additional secret.

# Set to true ONLY when building an isolated local demo, never public hosting.
# Production builds hide both the simulator and /demo/house-editor by default.
# This is evaluated at build time. Neither demo has a production database write path.
TOWN_DEMO_MODE=false
# Expanded OBS preview: requires npm run dev AND TOWN_DEMO_MODE=true, localhost,
# PUBLIC_DEPLOYMENT=false. Always 404 under npm start, even with this flag true.
# Use AUTH_STORAGE=memory for isolated preview runs; never claim production auth.
# My Houses needs migration 003 after 001/002, with no new credentials/scopes.
# Saves require the property's streamer to be signed in with Subscriber Housing
# authorized, so current membership can be checked using that existing user token.

# Public hosting: set PUBLIC_DEPLOYMENT=true, AUTH_STORAGE=supabase, and keep
# TOWN_DEMO_MODE=false at BUILD and runtime. Use the registered public HTTPS callback.
# Apply migrations 001–006 manually. Never point previews/local durable auth at the
# public database: one active auth process claims the durable session store.
# Local default memory preserves credential-free demo use; opt into supabase only
# against a development database to rehearse restart recovery.
PUBLIC_DEPLOYMENT=false
AUTH_STORAGE=memory
